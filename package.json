{
  "name": "@dreamlake/json-layer",
  "version": "0.2.0",
  "description": "Layered JSON configuration: JSON Lines of static overwrites and operators, resolved in order, with the source line of every value.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "json-layer": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamlake-ai/json-layer.git"
  },
  "homepage": "https://github.com/dreamlake-ai/json-layer#readme",
  "keywords": [
    "json",
    "jsonl",
    "layers",
    "overlay",
    "patch",
    "merge",
    "configuration"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc --noEmit && vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
